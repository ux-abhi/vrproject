{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "xr-spatial-tracking=(self)"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/case-study/paper(/.*)?",
      "destination": "/findings/",
      "permanent": false
    },
    {
      "source": "/paper(/.*)?",
      "destination": "/findings/",
      "permanent": false
    },
    {
      "source": "/case-study(/.*)?",
      "destination": "/",
      "permanent": false
    }
  ]
}
